# Paste your ElevenLabs key here (never commit .env)
ELEVENLABS_API_KEY=

# Pick a voice from: npm run voices
# Default is a common multilingual voice id (Rachel-like public voice)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# eleven_multilingual_v2 | eleven_turbo_v2_5 | eleven_flash_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 0.7–1.15 typical for Reels
ELEVENLABS_SPEED=1.05
