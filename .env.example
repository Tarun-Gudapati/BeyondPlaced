# Signs login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string (e.g. Neon via Vercel → Storage). Leave empty to use the
# built-in embedded database (stored in .data/ locally, reset on Vercel cold starts).
DATABASE_URL=

# Razorpay (Dashboard → Account & Settings → API Keys). Leave empty for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://<your-domain>/api/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
