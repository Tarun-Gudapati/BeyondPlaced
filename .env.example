# Signs login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string (e.g. Neon via Vercel → Storage). Leave empty to use the
# built-in embedded database (stored in .data/ locally, reset on Vercel cold starts).
DATABASE_URL=

# Comma-separated emails that get the /admin page and every lesson unlocked.
# ADMIN_EMAILS=you@example.com

# Optional Placement Pro master account. It is only created when MASTER_PASSWORD is set;
# use a long random password and never commit it.
# MASTER_EMAIL=master@beyondplaced.com
# MASTER_PASSWORD=
# MASTER_NAME=BeyondPlaced Master

# Supabase Storage for paid lesson videos (Project Settings → API). Lessons reference them as
# "supabase:<path>"; the service role key stays on the server and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=lesson-videos

# Razorpay (Dashboard → Account & Settings → API Keys). Leave empty for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://<your-domain>/api/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Simulated payments unlock paid plans for free; production only allows them when this is "true".
# ALLOW_TEST_PAYMENTS=
